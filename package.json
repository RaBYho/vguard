{
  "name": "vguard",
  "version": "1.0.0",
  "description": "Gestionnaire sécurisé de mots de passe et codes 2FA",
  "desktopName": "vguard.desktop",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:extension": "node scripts/build-extension.js",
    "test": "npm run build:main && node test/crypto-vault-test.js && node test/vault-integration-test.js && node test/native-messaging-test.js && node test/security-validation-test.js",
    "build": "npm run build:renderer && npm run build:main && npm run build:extension",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --no-sandbox\"",
    "start": "electron . --no-sandbox",
    "package": "npm run build && electron-builder",
    "setup:extension": "node scripts/install-native-host.js"
  },
  "keywords": [
    "password-manager",
    "2fa",
    "totp",
    "security",
    "electron"
  ],
  "author": "Hoby",
  "license": "MIT",
  "dependencies": {
    "argon2": "^0.41.0",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.460.0",
    "otpauth": "^9.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
